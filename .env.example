# =================================================================
# Baseline Wellness Platform - Environment Variables & API Keys
# =================================================================

# 1. Google Gemini AI API Key
# Used for: Server-side plain-language biometric synthesis & interactive AI physiological coach
# Get your key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Google Maps Platform API Key
# Used for: Interactive map rendering, wellness location discovery, recovery spots, and directions
# Get your key: https://console.cloud.google.com/google/maps-apis/start
GOOGLE_MAPS_PLATFORM_KEY=
VITE_GOOGLE_MAPS_PLATFORM_KEY=

# 3. Weather API Key (OpenWeatherMap / WeatherAPI)
# Used for: Live local weather forecasting, UV index, air quality, and outdoor recovery timing
# Get your key: https://openweathermap.org/api or https://www.weatherapi.com/
WEATHER_API_KEY=
VITE_WEATHER_API_KEY=

# 4. Stripe Payment Keys
# Used for: Pro and Family Circle membership subscriptions, card billing, and checkout processing
# Get your keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

